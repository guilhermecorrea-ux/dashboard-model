{
  "name": "bmb-sync",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Robô de sincronização: puxa Shopify, Bling, Meta (Windsor) e GA4 e grava no Supabase da empresa.",
  "scripts": {
    "sync": "tsx src/run.ts",
    "autorizar": "tsx scripts/autorizar.ts",
    "testar-fontes": "tsx scripts/testar-fontes.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "banco:aplicar": "tsx scripts/banco.ts aplicar",
    "banco:configurar": "tsx scripts/banco.ts configurar"
  },
  "devDependencies": {
    "@types/node": "20.17.10",
    "@types/pg": "8.11.10",
    "pg": "8.13.1",
    "tsx": "4.19.2",
    "typescript": "5.7.3",
    "vitest": "2.1.8"
  }
}
