# Copie para .env (nunca suba o .env para o GitHub). No GitHub Actions estes valores são "secrets".
SUPABASE_URL=https://<projeto>.supabase.co
SUPABASE_SERVICE_KEY=<service_role key do Supabase>
DATABASE_URL=<connection string do Supabase, modo Session (só na instalação)>
CLIENTE_SALT=<texto aleatório longo, usado para anonimizar ids de clientes>

SHOPIFY_LOJA=<loja>.myshopify.com
SHOPIFY_CLIENT_ID=<client id do app no Dev Dashboard>
SHOPIFY_CLIENT_SECRET=<client secret do app>

BLING_CLIENT_ID=<client id do app privado>
BLING_CLIENT_SECRET=<client secret do app privado>

WINDSOR_API_KEY=<chave da conta Windsor da empresa>
# Opcional: nomes dos campos do Meta no Windsor (confirme na instalação)
# WINDSOR_CAMPOS=date,campaign,spend,action_values_purchase,actions_purchase

GA4_PROPERTY_ID=<número da propriedade GA4>
GA4_SERVICE_ACCOUNT_JSON=<conteúdo do JSON da conta de serviço da holding, em uma linha>
